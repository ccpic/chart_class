# Environment variables for Chart Class 2 frontend (Next.js)
# Duplicate this file to .env.production and update the values before building.

# Public URL for the backend API exposed via Apache reverse proxy.
# Example: http://49.232.203.83:8080/chart_class2
NEXT_PUBLIC_API_URL="http://your-server:8080/chart_class2"

# Optional: override the port/host for the Next.js server when running manually.
# Comment out when using NSSM script that sets PORT automatically.
# PORT=3000
# HOSTNAME=127.0.0.1
